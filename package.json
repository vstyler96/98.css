  },
  "homepage": "https://github.com/vstyler96/98.css",
  "devDependencies": {
    "autoprefixer": "^10.4.8",
    "chokidar": "^3.3.1",
    "cssnano": "^5.0.1",
    "dedent": "^0.7.0",
    "ejs": "^3.0.2",
    "gh-pages": "^2.2.0",
    "glob": "^7.1.6",
    "highlight.js": "^10.4.1",
    "live-server": "^1.2.1",
    "mkdirp": "^1.0.4",
